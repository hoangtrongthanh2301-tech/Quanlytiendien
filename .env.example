# Application database connection
# This Docker setup intentionally connects to the host MySQL/XAMPP instance.
APP_PORT=8081
DB_HOST=host.docker.internal
DB_NAME=qltiendien
DB_USER=root
DB_PASSWORD=
DB_PORT=3306
DB_CONNECT_TIMEOUT=3
DB_READ_TIMEOUT=8

# Optional: set these in the cloud provider secret store
# FACE_DESCRIPTOR_KEY=change-this-key
# BLOCKCHAIN_PRIVATE_KEY_FILE=/var/www/html/storage/keys/blockchain_private.pem
# BLOCKCHAIN_PUBLIC_KEY_FILE=/var/www/html/storage/keys/blockchain_public.pem
